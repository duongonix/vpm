# Phase 8: typed accessors.

import cli

fn expect(label: str, actual: str, wanted: str) -> int:
  if actual == wanted:
    out("PASS $label")
    return 0
  out("FAIL $label: got=[$actual] want=[$wanted]")
  1

fn bool_text(value: bool) -> str:
  if value:
    return "true"
  "false"

fn main() -> int:
  failures = 0

  cmd = cli.command("serve").arg("count").option("port", short = "p")
  app = cli.app("demo").command(cmd)

  match cli.parse(app, @["serve", "42", "--port", "8080"]):
    ok(invocation):
      ctx = invocation.context
      count = ctx.arg_int_or("count", -1)
      port = ctx.option_int_or("port", -1)
      failures = failures + expect("arg.int", "$count", "42")
      failures = failures + expect("option.int", "$port", "8080")
    err(error):
      failures = failures + expect("c1.err", error.message, "")

  # Non-integer text must not silently become 0.
  match cli.parse(app, @["serve", "notanumber", "--port", "12x"]):
    ok(invocation):
      ctx = invocation.context
      count = ctx.arg_int_or("count", -1)
      port = ctx.option_int_or("port", -1)
      failures = failures + expect("arg.bad", "$count", "-1")
      failures = failures + expect("option.bad", "$port", "-1")
      maybe = ctx.option_int("port")
      if maybe == null:
        failures = failures + expect("option.null", "null", "null")
      else:
        failures = failures + expect("option.null", "some", "null")
    err(error):
      failures = failures + expect("c2.err", error.message, "")

  # Negative integers are accepted after `--`.
  match cli.parse(app, @["serve", "--", "-5"]):
    ok(invocation):
      count = invocation.context.arg_int_or("count", 0)
      failures = failures + expect("negative", "$count", "-5")
    err(error):
      failures = failures + expect("c3.err", error.message, "")

  # Missing value falls back.
  match cli.parse(app, @["serve", "1"]):
    ok(invocation):
      port = invocation.context.option_int_or("port", 3000)
      failures = failures + expect("missing", "$port", "3000")
    err(error):
      failures = failures + expect("c4.err", error.message, "")

  if failures == 0:
    out("TYPED-OK")
    return 0
  out("TYPED-FAILURES=$failures")
  1
