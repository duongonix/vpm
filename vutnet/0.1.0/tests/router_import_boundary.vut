# The Router API imported through a module alias (package/module boundary), with
# the router and controllers declared in this consuming module.
import vutnet.router as r
import vutnet.context at Context
import vutnet.response at Response
import vutnet.response as response

fn home(ctx: Context) -> Response:
  response.send(200, "home")

fn render(entries: list[r.RouteEntry]) -> str:
  lines: list[str] = @[]
  for entry in entries:
    for m in entry.methods:
      lines.push(m.text() + " " + entry.path)
  lines.join("\n")

fn BoundaryRouter() -> r.Router:
  r.router():
    Route(path = "/", controller = home)
    Routes(path = "/group"):
      Route(path = "/leaf", controller = home)

fn expect(label: str, actual: str, wanted: str) -> int:
  if actual == wanted:
    out("ok $label")
    return 0
  out("FAIL $label")
  out("  got:  [$actual]")
  out("  want: [$wanted]")
  1

fn main() -> int:
  match BoundaryRouter().flatten():
    ok(entries):
      expect("module_alias_boundary", render(entries), "GET /\nGET /group/leaf")
    err(error):
      expect("module_alias_boundary", error.message, "ok")
