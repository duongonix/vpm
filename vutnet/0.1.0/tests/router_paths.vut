# Path normalization: root handling, leading/trailing slashes, deep prefixes and
# the "never produce //" invariant.
import vutnet.router at router, Router, Controller, RouteEntry, RouterError
import vutnet.context at Context
import vutnet.response at Response
import vutnet.response as response

fn home(ctx: Context) -> Response:
  response.send(200, "home")

fn render(entries: list[RouteEntry]) -> str:
  lines: list[str] = @[]
  for entry in entries:
    for m in entry.methods:
      lines.push(m.text() + " " + entry.path)
  lines.join("\n")

fn expect(label: str, actual: str, wanted: str) -> int:
  if actual == wanted:
    out("ok $label")
    return 0
  out("FAIL $label")
  out("  got:  [$actual]")
  out("  want: [$wanted]")
  1

fn root_slash() -> Router:
  router():
    Route(path = "/", controller = home)

fn root_empty() -> Router:
  router():
    Route(path = "", controller = home)

fn leading_slash() -> Router:
  router():
    Route(path = "/health", controller = home)

fn omitted_leading_slash() -> Router:
  router():
    Route(path = "health", controller = home)

fn trailing_slash() -> Router:
  router():
    Route(path = "/health/", controller = home)

fn group_trailing_slash() -> Router:
  router():
    Routes(path = "/admin/"):
      Route(path = "/setting/", controller = home)

fn nested_relative() -> Router:
  router():
    Routes(path = "api"):
      Routes(path = "v1"):
        Route(path = "items", controller = home)

fn AdminRouter() -> Router:
  router():
    Route(path = "/", controller = home)
    Routes(path = "/users/"):
      Route(path = "/", controller = home)

fn mounted_with_slashes() -> Router:
  router():
    UseRouter(path = "/admin/", router = AdminRouter)

fn check(label: str, built: result[list[RouteEntry], RouterError], wanted: str) -> int:
  match built:
    ok(entries): expect(label, render(entries), wanted)
    err(error): expect(label, error.message, "ok")

fn main() -> int:
  failures = 0
  failures = failures + check("root_slash", root_slash().flatten(), "GET /")
  failures = failures + check("root_empty", root_empty().flatten(), "GET /")
  failures = failures + check("leading_slash", leading_slash().flatten(), "GET /health")
  failures = failures + check("omitted_leading", omitted_leading_slash().flatten(), "GET /health")
  failures = failures + check("trailing_slash", trailing_slash().flatten(), "GET /health")
  failures = failures + check("group_trailing", group_trailing_slash().flatten(), "GET /admin/setting")
  failures = failures + check("nested_relative", nested_relative().flatten(), "GET /api/v1/items")
  failures = failures + check("no_double_slash", mounted_with_slashes().flatten(), "GET /admin\nGET /admin/users")
  failures
