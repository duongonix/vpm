# Stable read-only projections keep the node table private while making common
# structural facts and text content inspectable by applications and tests.
fn View.root_count() -> int:
  count = 0
  for node in self._nodes:
    if node._parent < 0:
      count = count + 1
  count

fn View.text_content() -> str:
  result = ""
  for node in self._nodes:
    if node._is_text:
      result = result + node._text
  result

# Event bindings target elements by exact, unique id. Keep this projection
# narrow so the separate event module never needs access to ViewNode fields.
fn View.element_id_count(id: str) -> int:
  count = 0
  for node in self._nodes:
    if not node._is_text and not node._is_slot:
      for attribute in node._attrs:
        if attribute._name == "id" and attribute._value == id:
          count = count + 1
  count
