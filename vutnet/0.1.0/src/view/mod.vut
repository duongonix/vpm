# Vutnet View builder. Receiver methods live beside ChildrenScope because the
# current compiler only permits receiver extensions in the receiver's module.
import.event_types at EventHandlers, EventHandler, MouseEventHandler, InputEventHandler, ChangeEventHandler, KeyboardEventHandler, FocusEventHandler, SubmitEventHandler, event_handlers
import.tracking at initial_value
import.hydration at HydrationPlanEntry, HydrationPlanInput, occurrence_plan

data Attribute:
  _name: str
  _value: str
  _is_boolean: bool
  _enabled: bool
  _is_css: bool

type _TextBinding = fn() -> str
type _AttrsBinding = fn() -> list[Attribute]
type _ChildrenBinding = fn() -> View

@abi_schema(3)
data ViewNode:
  _is_text: bool
  _is_slot: bool
  _required_slot: bool
  _parent: int
  _name: str
  _slot_name: str
  _text: str
  _attrs: list[Attribute]
  _events: EventHandlers
  _call_site_id: u64
  _text_binding: _TextBinding? = null
  _attrs_binding: _AttrsBinding? = null
  _base_attrs: list[Attribute] = @[]
  _children_binding: _ChildrenBinding? = null

@abi_schema(4)
data View:
  _nodes: list[ViewNode]
  _hydration_plan: list[HydrationPlanEntry] = @[]
  # Error text is part of the public managed browser callback layout; the
  # native SSR path still returns the same typed result[str, str].
  _layout_error: str? = null

# The managed SSR import deliberately receives a callback-free projection.
# Browser-only event closures remain on ViewNode and never cross the native
# renderer boundary.
@abi_schema(2)
data ViewRenderNode:
  _is_text: bool
  _is_slot: bool
  _required_slot: bool
  _parent: int
  _name: str
  _slot_name: str
  _text: str
  _attrs: list[Attribute]
  _call_site_id: u64

@abi_schema(4)
data ViewRender:
  _nodes: list[ViewRenderNode]
  _include_call_site_markers: bool
  _include_bootstrap: bool
  _bootstrap_has_data: bool
  _bootstrap_json: str
  _bootstrap_page_id: u64
  _hydration_plan: list[HydrationPlanEntry]

data _SlotSupply:
  _name: str
  _content: View

type _Layout = fn() -> View

enum _ViewError:
  missing_required_slot
  duplicate_slot
  unknown_slot
  invalid_slot_name
  unresolved_nested_slot
  slot_without_layout
  nested_render_failure

fn _ViewError.message() -> str:
  match self:
    missing_required_slot: "missing required view slot"
    duplicate_slot: "duplicate view slot"
    unknown_slot: "unknown view slot"
    invalid_slot_name: "invalid view slot name"
    unresolved_nested_slot: "unresolved nested view slot"
    slot_without_layout: "view declares slots but has no layout"
    nested_render_failure: "nested view failed to resolve its layout"

extern "VutManaged" fn _view_render_native(value: ViewRender) -> result[str, str]

data ChildrenScope:
  _nodes: list[ViewNode]
  _parent: int
  _collect_slot_supplies: bool
  _supplies: list[_SlotSupply]
  # Keep only error presence here; View carries the typed error at the boundary.
  _has_error: bool
  _allows_children_binding: bool = false
  _children_binding: _ChildrenBinding? = null
  _attrs_binding: _AttrsBinding? = null
  _dynamic_attrs: list[Attribute] = @[]

fn attr(name: str, value: str) -> Attribute:
  Attribute(_name: name, _value: value, _is_boolean: false, _enabled: true, _is_css: false)

fn bool_attr(name: str, enabled: bool) -> Attribute:
  Attribute(_name: name, _value: "", _is_boolean: true, _enabled: enabled, _is_css: false)

# Optional shortcuts are normalized into the same Attribute list consumed by
# ViewNode and the native HTML validator/serializer.
fn _add_text_attribute(output: list[Attribute], name: str, value: str?) -> list[Attribute]:
  if value != null:
    output.push(attr(name, value))
  output

fn _add_numeric_attribute(output: list[Attribute], name: str, value: int?) -> list[Attribute]:
  if value != null:
    output.push(attr(name, "$value"))
  output

fn _add_boolean_attribute(output: list[Attribute], name: str, value: bool) -> list[Attribute]:
  if value:
    output.push(bool_attr(name, true))
  output

fn _add_custom_attributes(output: list[Attribute], values: list[Attribute]) -> list[Attribute]:
  for value in values:
    output.push(value)
  output

fn _css_attribute(name: str, value: str) -> Attribute:
  Attribute(_name: name, _value: value, _is_boolean: false, _enabled: true, _is_css: true)

fn _add_css_attributes(output: list[Attribute], css: map[str, str]) -> list[Attribute]:
  keys = css.keys()
  for name in keys:
    output.push(_css_attribute(name, css.get_or(name, "")))
  output

fn _prefer_error(current: str?, next: str?) -> str?:
  preferred: str? = next
  if current != null:
    preferred = current
  preferred

fn _first_supply_error(supplies: list[_SlotSupply]) -> str?:
  found: str? = null
  for supply in supplies:
    found = _prefer_error(found, supply._content._layout_error)
  found

# `view()` builds a page or a layout template. A layout passed to an overload
# below is invoked and its slots are resolved inside this module.
fn view(body: fn(ChildrenScope)() -> void) -> View:
  _assign_occurrences(_view_without_layout(body))

fn view(layout: _Layout, body: fn(ChildrenScope)() -> void) -> View:
  _assign_occurrences(_view_with_layout(layout(), body))

fn view(layout: View, body: fn(ChildrenScope)() -> void) -> View:
  _assign_occurrences(_view_with_layout(layout, body))

# Assign a deterministic per-site occurrence after all fragments/components/
# layout slots have been flattened. The same function runs in native and WASM.
fn _assign_occurrences(value: View) -> View:
  if value._layout_error != null:
    return value
  inputs: list[HydrationPlanInput] = @[]
  for node in value._nodes:
    kind = if node._is_text:
      "text"
    else:
      "element"
    inputs.push(
      HydrationPlanInput(
        _site_id: node._call_site_id,
        _parent: node._parent,
        _kind: kind,
        _name: node._name
      )
    )
  View(_nodes: value._nodes, _hydration_plan: occurrence_plan(inputs))

fn _view_without_layout(body: fn(ChildrenScope)() -> void) -> View:
  nodes: list[ViewNode] = @[]
  scope = ChildrenScope(
    _nodes: nodes,
    _parent: -1,
    _collect_slot_supplies: false,
    _supplies: @[],
    _has_error: false
  )
  body.call(scope)
  if scope._has_error:
    return View(_nodes: @[], _layout_error: _ViewError.nested_render_failure.message())
  View(_nodes: scope._nodes)

fn _view_with_layout(template: View, body: fn(ChildrenScope)() -> void) -> View:
  nodes: list[ViewNode] = @[]
  supplies: list[_SlotSupply] = @[]
  scope = ChildrenScope(
    _nodes: nodes,
    _parent: -1,
    _collect_slot_supplies: true,
    _supplies: supplies,
    _has_error: false
  )
  body.call(scope)
  if scope._has_error:
    return View(_nodes: @[], _layout_error: _ViewError.nested_render_failure.message())
  if scope._nodes.len() > 0:
    scope._supplies.push(
      _SlotSupply(_name: "content", _content: View(_nodes: scope._nodes))
    )
  match _resolve(template, scope._supplies):
    ok(resolved): resolved
    err(error): View(_nodes: @[], _layout_error: error)

fn ChildrenScope._push(node: ViewNode) -> void:
  if self._children_binding != null:
    self._has_error = true
  else:
    self._nodes.push(node)

fn ChildrenScope._node_count() -> int:
  self._nodes.len()

@track_caller
fn ChildrenScope.text(value: str) -> void:
  self._push(
    ViewNode(
      _is_text: true,
      _is_slot: false,
      _required_slot: false,
      _parent: self._parent,
      _name: "",
      _slot_name: "",
      _text: value,
      _attrs: @[],
      _events: EventHandlers(),
      _call_site_id: caller_call_site_id()
    )
  )

# Typed binding methods stay beside ChildrenScope for receiver resolution;
# dependency isolation and browser scheduling live in focused modules.
@track_caller
fn ChildrenScope.text(value: _TextBinding) -> void:
  if self._children_binding != null:
    self._has_error = true
    return
  evaluated = initial_value[str](value)
  self.text(evaluated)
  node = self._nodes.at(self._nodes.len() - 1)
  node._text_binding = value
  self._nodes.set(self._nodes.len() - 1, node)

fn ChildrenScope.bind_attrs(value: _AttrsBinding) -> void:
  if self._nodes.len() == 0:
    if not self._allows_children_binding or self._attrs_binding != null:
      self._has_error = true
      return
    self._dynamic_attrs = initial_value[list[Attribute]](value)
    self._attrs_binding = value
    return
  index = self._nodes.len() - 1
  node = self._nodes.at(index)
  if node._is_text or node._is_slot or node._attrs_binding != null:
    self._has_error = true
    return
  node._base_attrs = node._attrs
  node._attrs = _add_custom_attributes(node._attrs, initial_value[list[Attribute]](value))
  node._attrs_binding = value
  self._nodes.set(index, node)

fn ChildrenScope.children(value: _ChildrenBinding) -> void:
  if not self._allows_children_binding or self._nodes.len() != 0 or self._children_binding != null:
    self._has_error = true
    return
  self.child(initial_value[View](value))
  self._children_binding = value

# Insert component roots and remap local parent indices into this flat preorder
# table. This preserves order and supports components with multiple roots.
fn ChildrenScope.child(value: View) -> void:
  if value._layout_error != null:
    self._has_error = true
  base = self._node_count()
  for node in value._nodes:
    parent = if node._parent < 0:
      self._parent
    else:
      base + node._parent
    self._push(
      ViewNode(
        _is_text: node._is_text,
        _is_slot: node._is_slot,
        _required_slot: node._required_slot,
        _parent: parent,
        _name: node._name,
        _slot_name: node._slot_name,
        _text: node._text,
        _attrs: node._attrs,
        _events: node._events,
        _call_site_id: node._call_site_id,
        _text_binding: node._text_binding,
        _attrs_binding: node._attrs_binding,
        _base_attrs: node._base_attrs,
        _children_binding: node._children_binding
      )
    )

@track_caller
fn ChildrenScope._append_element(
  name: str,
  attrs: list[Attribute],
  body: fn(ChildrenScope)() -> void
) -> void:
  self._append_element_with_events(name, attrs, EventHandlers(), body)

@track_caller
fn ChildrenScope._append_element_with_events(
  name: str,
  attrs: list[Attribute],
  events: EventHandlers,
  body: fn(ChildrenScope)() -> void
) -> void:
  index = self._node_count()
  nodes: list[ViewNode] = @[]
  child_scope = ChildrenScope(
    _nodes: nodes,
    _parent: -1,
    _collect_slot_supplies: false,
    _supplies: @[],
    _has_error: false,
    _allows_children_binding: true
  )
  body.call(child_scope)
  if child_scope._has_error:
    self._has_error = true
  self._push(
    ViewNode(
      _is_text: false,
      _is_slot: false,
      _required_slot: false,
      _parent: self._parent,
      _name: name,
      _slot_name: "",
      _text: "",
      _attrs: _add_custom_attributes(attrs, child_scope._dynamic_attrs),
      _events: events,
      _call_site_id: caller_call_site_id(),
      _children_binding: child_scope._children_binding,
      _attrs_binding: child_scope._attrs_binding,
      _base_attrs: attrs
    )
  )
  base = self._node_count()
  for node in child_scope._nodes:
    parent = if node._parent < 0:
      index
    else:
      base + node._parent
    self._push(
      ViewNode(
        _is_text: node._is_text,
        _is_slot: node._is_slot,
        _required_slot: node._required_slot,
        _parent: parent,
        _name: node._name,
        _slot_name: node._slot_name,
        _text: node._text,
        _attrs: node._attrs,
        _events: node._events,
        _call_site_id: node._call_site_id,
        _text_binding: node._text_binding,
        _attrs_binding: node._attrs_binding,
        _base_attrs: node._base_attrs,
        _children_binding: node._children_binding
      )
    )

@track_caller
fn ChildrenScope._append_void(name: str, attrs: list[Attribute]) -> void:
  self._append_void_with_events(name, attrs, EventHandlers())

@track_caller
fn ChildrenScope._append_void_with_events(
  name: str,
  attrs: list[Attribute],
  events: EventHandlers
) -> void:
  self._push(
    ViewNode(
      _is_text: false,
      _is_slot: false,
      _required_slot: false,
      _parent: self._parent,
      _name: name,
      _slot_name: "",
      _text: "",
      _attrs: attrs,
      _events: events,
      _call_site_id: caller_call_site_id()
    )
  )

@track_caller
fn ChildrenScope.html(
  id: str? = null,
  class: str? = null,
  lang: str? = null,
  attrs: list[Attribute] = @[],
  css: map[str, str] = (),
  body: fn(ChildrenScope)() -> void
) -> void:
  attributes: list[Attribute] = @[]
  attributes = _add_text_attribute(attributes, "id", id)
  attributes = _add_text_attribute(attributes, "class", class)
  attributes = _add_text_attribute(attributes, "lang", lang)
  attributes = _add_custom_attributes(attributes, attrs)
  attributes = _add_css_attributes(attributes, css)
  self._append_element("html", attributes, body)

