# Without a body, a slot is required. During page composition it supplies an
# empty value only when explicitly requested; template rendering detects misses.
@track_caller
fn ChildrenScope.slot(name: str) -> void:
  if self._collect_slot_supplies:
    self._supplies.push(
      _SlotSupply(_name: name, _content: View(_nodes: @[]))
    )
    return
  self._append_slot(name, true, View(_nodes: @[]))

@track_caller
fn ChildrenScope.slot(name: str, body: fn(ChildrenScope)() -> void) -> void:
  nodes: list[ViewNode] = @[]
  content = ChildrenScope(
    _nodes: nodes,
    _parent: -1,
    _collect_slot_supplies: false,
    _supplies: @[],
    _has_error: false
  )
  body.call(content)
  if content._has_error:
    self._has_error = true
  if self._collect_slot_supplies:
    self._supplies.push(
      _SlotSupply(_name: name, _content: View(_nodes: content._nodes))
    )
    return
  self._append_slot(name, false, View(_nodes: content._nodes))

@track_caller
fn ChildrenScope._append_slot(name: str, required: bool, fallback: View) -> void:
  index = self._node_count()
  self._push(
    ViewNode(
      _is_text: false,
      _is_slot: true,
      _required_slot: required,
      _parent: self._parent,
      _name: "",
      _slot_name: name,
      _text: "",
      _attrs: @[],
      _events: EventHandlers(),
      _call_site_id: caller_call_site_id()
    )
  )
  base = self._node_count()
  for node in fallback._nodes:
    parent = if node._parent < 0:
      index
    else:
      base + node._parent
    self._push(
      ViewNode(
        _is_text: node._is_text,
        _is_slot: node._is_slot,
        _required_slot: node._required_slot,
        _parent: parent,
        _name: node._name,
        _slot_name: node._slot_name,
        _text: node._text,
        _attrs: node._attrs,
        _events: node._events,
        _call_site_id: node._call_site_id,
        _text_binding: node._text_binding,
        _attrs_binding: node._attrs_binding,
        _base_attrs: node._base_attrs,
        _children_binding: node._children_binding
      )
    )

# Rendering is a managed native import. The Rust implementation receives a
# callback-free projection so browser event closures never cross the SSR ABI.
fn _render_node(node: ViewNode) -> ViewRenderNode:
  ViewRenderNode(
    _is_text: node._is_text,
    _is_slot: node._is_slot,
    _required_slot: node._required_slot,
    _parent: node._parent,
    _name: node._name,
    _slot_name: node._slot_name,
    _text: node._text,
    _attrs: node._attrs,
    _call_site_id: node._call_site_id
  )

fn render(value: View) -> result[str, str]:
  _render(value, false, false, false, "", 0)

fn render_hydratable(value: View) -> result[str, str]:
  _render(value, true, false, false, "", 0)

# Used by response.render_hydratable. `data_json` is emitted as inert JSON in
# an application/json script node, never as executable JavaScript.
fn render_hydratable_with_bootstrap(
  value: View,
  page_id: u64,
  has_data: bool,
  data_json: str
) -> result[str, str]:
  _render(value, true, true, has_data, data_json, page_id)

fn _render(
  value: View,
  include_markers: bool,
  include_bootstrap: bool,
  has_data: bool,
  data_json: str,
  page_id: u64
) -> result[str, str]:
  match value._layout_error:
    null: _render_resolved(value, include_markers, include_bootstrap, has_data, data_json, page_id)
    error: err(error)

fn _render_resolved(
  value: View,
  include_markers: bool,
  include_bootstrap: bool,
  has_data: bool,
  data_json: str,
  page_id: u64
) -> result[str, str]:
  nodes: list[ViewRenderNode] = @[]
  for node in value._nodes:
    nodes.push(_render_node(node))
  render_view = ViewRender(
    _nodes: nodes,
    _include_call_site_markers: include_markers,
    _include_bootstrap: include_bootstrap,
    _bootstrap_has_data: has_data,
    _bootstrap_json: data_json,
    _bootstrap_page_id: page_id,
    _hydration_plan: value._hydration_plan
  )
  unsafe:
    _view_render_native(render_view)

fn _subtree_end(nodes: list[ViewNode], root: int) -> int:
  for candidate in (root + 1) .. nodes.len():
    if nodes.at(candidate)._parent < root:
      return candidate
  nodes.len()

# Resolve one template layer. Kept private to the View builder; application
# layouts return ordinary Views and never pass slot metadata.
fn _resolve(layout: View, supplies: list[_SlotSupply]) -> result[View, str]:
  error: str? = _prefer_error(layout._layout_error, _first_supply_error(supplies))
  if error != null:
    return err(error)
  _resolve_nodes(layout, supplies)

fn _resolve_nodes(layout: View, supplies: list[_SlotSupply]) -> result[View, str]:
  for left in 0 .. supplies.len():
    for right in (left + 1) .. supplies.len():
      if supplies.at(left)._name == supplies.at(right)._name:
        return err(_ViewError.duplicate_slot.message())

  output: list[ViewNode] = @[]
  source_to_output: list[int] = @[]
  declared: list[str] = @[]
  used: list[bool] = @[]
  for _ in supplies:
    used.push(false)
  skip_through = -1

  for index in 0 .. layout._nodes.len():
    node = layout._nodes.at(index)
    if index <= skip_through:
      source_to_output.push(-1)
    else:
      parent = if node._parent < 0:
        -1
      else:
        source_to_output.at(node._parent)

      if node._is_slot:
        if node._slot_name.byte_len() == 0:
          return err(_ViewError.invalid_slot_name.message())
        for previous in declared:
          if previous == node._slot_name:
            return err(_ViewError.duplicate_slot.message())
        declared.push(node._slot_name)
        supply_index = -1
        for candidate in 0 .. supplies.len():
          if supplies.at(candidate)._name == node._slot_name:
            supply_index = candidate

        source_to_output.push(parent)
        if supply_index >= 0:
          used.set(supply_index, true)
          supplied = supplies.at(supply_index)._content
          for supplied_node in supplied._nodes:
            if supplied_node._is_slot:
              return err(_ViewError.unresolved_nested_slot.message())
          base = output.len()
          for supplied_node in supplied._nodes:
            supplied_parent = if supplied_node._parent < 0:
              parent
            else:
              base + supplied_node._parent
            output.push(
              ViewNode(
                _is_text: supplied_node._is_text,
                _is_slot: supplied_node._is_slot,
                _required_slot: supplied_node._required_slot,
                _parent: supplied_parent,
                _name: supplied_node._name,
                _slot_name: supplied_node._slot_name,
                _text: supplied_node._text,
                _attrs: supplied_node._attrs,
                _events: supplied_node._events,
                _call_site_id: supplied_node._call_site_id,
                _text_binding: supplied_node._text_binding,
                _attrs_binding: supplied_node._attrs_binding,
                _base_attrs: supplied_node._base_attrs,
                _children_binding: supplied_node._children_binding
              )
            )
          skip_through = _subtree_end(layout._nodes, index) - 1
        else:
          if node._required_slot:
            return err(_ViewError.missing_required_slot.message())
      else:
        output_index = output.len()
        source_to_output.push(output_index)
        output.push(
          ViewNode(
            _is_text: node._is_text,
            _is_slot: false,
            _required_slot: false,
            _parent: parent,
            _name: node._name,
            _slot_name: "",
            _text: node._text,
            _attrs: node._attrs,
            _events: node._events,
            _call_site_id: node._call_site_id,
            _text_binding: node._text_binding,
            _attrs_binding: node._attrs_binding,
            _base_attrs: node._base_attrs,
            _children_binding: node._children_binding
          )
        )

  for index in 0 .. supplies.len():
    if not used.at(index):
      return err(_ViewError.unknown_slot.message())
  ok(View(_nodes: output))

# HTML void elements do not accept child callbacks.
# HTML void elements normalize their attributes through the same pipeline.
@track_caller
fn ChildrenScope.br(
  id: str? = null,
  class: str? = null,
  attrs: list[Attribute] = @[],
  css: map[str, str] = ()
) -> void:
  attributes: list[Attribute] = @[]
  attributes = _add_text_attribute(attributes, "id", id)
  attributes = _add_text_attribute(attributes, "class", class)
  attributes = _add_custom_attributes(attributes, attrs)
  attributes = _add_css_attributes(attributes, css)
  self._append_void("br", attributes)

@track_caller
fn ChildrenScope.img(
  id: str? = null,
  class: str? = null,
  src: str? = null,
  alt: str? = null,
  width: int? = null,
  height: int? = null,
  loading: str? = null,
  attrs: list[Attribute] = @[],
  css: map[str, str] = ()
) -> void:
  attributes: list[Attribute] = @[]
  attributes = _add_text_attribute(attributes, "id", id)
  attributes = _add_text_attribute(attributes, "class", class)
  attributes = _add_text_attribute(attributes, "src", src)
  attributes = _add_text_attribute(attributes, "alt", alt)
  attributes = _add_numeric_attribute(attributes, "width", width)
  attributes = _add_numeric_attribute(attributes, "height", height)
  attributes = _add_text_attribute(attributes, "loading", loading)
  attributes = _add_custom_attributes(attributes, attrs)
  attributes = _add_css_attributes(attributes, css)
  self._append_void("img", attributes)

@track_caller
fn ChildrenScope.input(
  id: str? = null,
  class: str? = null,
  input_type: str? = null,
  name: str? = null,
  value: str? = null,
  placeholder: str? = null,
  required: bool = false,
  disabled: bool = false,
  checked: bool = false,
  readonly: bool = false,
  autocomplete: str? = null,
  min: float? = null,
  max: float? = null,
  step: float? = null,
  minlength: int? = null,
  maxlength: int? = null,
  on_input: InputEventHandler? = null,
  on_change: ChangeEventHandler? = null,
  on_focus: FocusEventHandler? = null,
  on_blur: FocusEventHandler? = null,
  on_key_down: KeyboardEventHandler? = null,
  on_key_up: KeyboardEventHandler? = null,
  on_click: MouseEventHandler? = null,
  on_invalid: EventHandler? = null,
  attrs: list[Attribute] = @[],
  css: map[str, str] = ()
) -> void:
  attributes: list[Attribute] = @[]
  if id != null:
    attributes.push(attr("id", id))
  if class != null:
    attributes.push(attr("class", class))
  if input_type != null:
    attributes.push(attr("type", input_type))
  if name != null:
    attributes.push(attr("name", name))
  if value != null:
    attributes.push(attr("value", value))
  if placeholder != null:
    attributes.push(attr("placeholder", placeholder))
  if required:
    attributes.push(bool_attr("required", true))
  if disabled:
    attributes.push(bool_attr("disabled", true))
  if checked:
    attributes.push(bool_attr("checked", true))
  if readonly:
    attributes.push(bool_attr("readonly", true))
  if autocomplete != null:
    attributes.push(attr("autocomplete", autocomplete))
  if min != null:
    attributes.push(attr("min", "$min"))
  if max != null:
    attributes.push(attr("max", "$max"))
  if step != null:
    attributes.push(attr("step", "$step"))
  if minlength != null:
    attributes.push(attr("minlength", "$minlength"))
  if maxlength != null:
    attributes.push(attr("maxlength", "$maxlength"))
  attributes = _add_custom_attributes(attributes, attrs)
  attributes = _add_css_attributes(attributes, css)
  self._append_void_with_events(
    "input",
    attributes,
    event_handlers(
      on_input = on_input,
      on_change = on_change,
      on_focus = on_focus,
      on_blur = on_blur,
      on_key_down = on_key_down,
      on_key_up = on_key_up,
      on_click = on_click,
      on_invalid = on_invalid
    )
  )

@track_caller
fn ChildrenScope.source(
  src: str? = null,
  source_type: str? = null,
